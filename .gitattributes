# Zeilenenden festnageln, unabhaengig von core.autocrlf der jeweiligen Maschine.
# Dieses Repo wird auf Windows UND Linux/macOS ausgecheckt.

* text=auto eol=lf

# Skripte, die auf Unix ausgefuehrt werden: LF ist Pflicht.
# Ein CRLF im Shebang macht install.sh unter Linux unbrauchbar.
*.sh   text eol=lf
*.zsh  text eol=lf
*.bash text eol=lf
*.lua  text eol=lf
*.conf text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf

# PowerShell laeuft nur unter Windows — CRLF ist dort die Hausnorm.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Binaeres nicht anfassen.
*.zip  binary
*.png  binary
*.exe  binary
